# Proofestra local v1 configuration (never commit a real .env).
# All variables are optional; a mock-only install needs none of them.

# Loopback listener. Public/LAN exposure is out of scope for v1.
PROOFESTRA_HOST=127.0.0.1
PROOFESTRA_PORT=3000

# Deterministic location for the SQLite database and local exports.
# Defaults to ./data under the project root when unset.
PROOFESTRA_DATA_DIR=./data

# Enable Live execution mode. Mock mode is always available.
# When "0" (default) no provider call ever leaves this process.
PROOFESTRA_LIVE_ENABLED=0

# Provider credentials. Stay server-only; never exposed to the browser or exports.
# Setting a key does NOT auto-enable Live; PROOFESTRA_LIVE_ENABLED=1 is required
# and each run must still opt in with execution_mode=live.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model IDs. Defaults are the vendor-published current IDs verified on
# 2026-10-21 at:
#   https://developers.openai.com/api/docs/models/gpt-5.6-terra
#   https://platform.claude.com/docs/en/models/overview
#   https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
# gemini-2.5-flash is restricted to accounts with prior active use per Google's
# model page, so the Gemini default is 3.8 Flash; override to 2.5 Flash via
# GEMINI_MODEL=gemini-2.5-flash if your account retains access.
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash

# Optional override of the loopback canonical origin.
# Defaults to http://PROOFESTRA_HOST:PROOFESTRA_PORT.
# PROOFESTRA_ORIGIN=http://127.0.0.1:3000

# Additional loopback origins accepted for Origin and Host headers.
# Leave unset in production. The Vite dev server (`npm run dev`) rewrites the
# proxied Origin to match the API server, so you only need to list extras when
# serving the UI from a non-canonical loopback port.
# PROOFESTRA_EXTRA_ORIGINS=http://127.0.0.1:5173

# Optional override of the deterministic mock adapter per-call latency.
# Milliseconds added to every mock call (default 50). Raise during manual
# cancellation / partial-run testing; lower in CI for speed.
# PROOFESTRA_MOCK_LATENCY_MS=50

# Optional JSON file that extends or replaces the built-in server profile
# catalog (see src/core/profileConfig.ts). File format:
# { "mode": "append" | "replace", "profiles": [ { "profile_id": "...", ... } ] }
# PROOFESTRA_PROFILES_FILE=/absolute/path/to/profiles.json

# Optional dev server host / port used by Vite only (loopback-enforced).
# PROOFESTRA_DEV_HOST=127.0.0.1
# PROOFESTRA_DEV_PORT=5173

# Native (vendor CLI) backend: Codex through the EXISTING vendor-managed ChatGPT
# login. No credential is configured here and none is ever read by this app; the
# CLI finds its own login. Off by default. Even when enabled, execution stays
# fail-closed (readiness "unverified") until the tool surface is proven for the
# installed CLI version; see docs/decisions.md DLOG-018 and docs/requirements.md
# PR-08..PR-13. This is subscription quota, not API credit, and never costs "$0".
# PROOFESTRA_CODEX_ENABLED=0
# Exact model ID to pin (no default; an unpinned model is refused).
# PROOFESTRA_CODEX_MODEL=
# Optional absolute path of the codex executable. When unset only the fixed
# candidates /opt/homebrew/bin/codex and /usr/local/bin/codex are used (never $PATH).
# PROOFESTRA_CODEX_BIN=/absolute/path/to/codex
# Optional absolute path of the directory the CLI itself uses for its login. Passed
# through as a path only; the app never opens it.
# PROOFESTRA_CODEX_HOME=/absolute/path/to/.codex
