{
  "name": "proofestra",
  "version": "0.1.0",
  "private": true,
  "description": "Proofestra local-first multi-agent chat (mock-backed v1; live providers opt-in).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning dist/server/server/index.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:parsers": "node --import tsx scripts/verify-parser-tools.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && node tests/smoke/worker-dist.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv-formats": "3.0.1",
    "ajv8": "npm:ajv@8.20.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "js-yaml": "4.3.2",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
